<Window x:Class="AuthApp.AdminDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора" Height="550" Width="850"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Панель управления администратора" FontSize="20" 
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"
                   Foreground="DarkBlue"/>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <Button x:Name="btnAdd" Content="➕ Добавить пользователя" Width="180" Height="40" 
                    Margin="10" Background="LightGreen" FontSize="14" FontWeight="Bold"
                    Click="btnAdd_Click"/>
            <Button x:Name="btnEdit" Content="✏️ Редактировать выбранного" Width="200" Height="40" 
                    Margin="10" Background="LightBlue" FontSize="14" FontWeight="Bold"
                    Click="btnEdit_Click"/>
            <Button x:Name="btnUnblock" Content="🔓 Разблокировать выбранного" Width="210" Height="40" 
                    Margin="10" Background="Orange" FontSize="14" FontWeight="Bold"
                    Click="btnUnblock_Click"/>
            <Button x:Name="btnRefresh" Content="🔄 Обновить список" Width="160" Height="40" 
                    Margin="10" Background="LightGray" FontSize="14" FontWeight="Bold"
                    Click="btnRefresh_Click"/>
        </StackPanel>
        
        <DataGrid x:Name="dgUsers" Grid.Row="2" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single" Margin="5"
                  AlternatingRowBackground="LightYellow" FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="130"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="80"/>
                <DataGridCheckBoxColumn Header="Заблокирован" Binding="{Binding IsBlocked}" Width="100"/>
                <DataGridTextColumn Header="Кол-во ошибок" Binding="{Binding ErrorCount}" Width="100"/>
                <DataGridTextColumn Header="Последний вход" Binding="{Binding LastLoginDate}" Width="160"/>
                <DataGridCheckBoxColumn Header="Требуется смена пароля" Binding="{Binding NeedChangePassword}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
