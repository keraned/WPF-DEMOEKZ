<Window x:Class="AuthApp.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование пользователя" Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Редактирование пользователя" FontSize="20" 
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"
                   Foreground="DarkBlue"/>
        
        <StackPanel Grid.Row="1" Margin="0,10">
            <TextBlock Text="Логин:" FontSize="14" Margin="0,0,0,5" FontWeight="Bold"/>
            <TextBox x:Name="txtLogin" Height="35" FontSize="14" IsEnabled="False" Background="LightGray"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Margin="0,10">
            <TextBlock Text="Новый пароль (оставьте пустым, чтобы не менять):" FontSize="14" Margin="0,0,0,5" FontWeight="Bold"/>
            <PasswordBox x:Name="txtPassword" Height="35" FontSize="14" BorderThickness="1"/>
        </StackPanel>
        
        <StackPanel Grid.Row="3" Margin="0,10">
            <TextBlock Text="Роль:" FontSize="14" Margin="0,0,0,5" FontWeight="Bold"/>
            <ComboBox x:Name="cmbRole" Height="35" FontSize="14"/>
        </StackPanel>
        
        <StackPanel Grid.Row="4" Margin="0,10">
            <CheckBox x:Name="chkResetPassword" Margin="0,10">
                <TextBlock Text="Требовать смену пароля при следующем входе (для обычных пользователей)" FontSize="12" TextWrapping="Wrap" Width="350"/>
            </CheckBox>
        </StackPanel>
        
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button x:Name="btnSave" Content="Сохранить изменения" Width="150" Height="40" 
                    Margin="10" Background="LightGreen" FontSize="14" FontWeight="Bold"
                    Click="btnSave_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="130" Height="40" 
                    Margin="10" Background="LightCoral" FontSize="14" FontWeight="Bold"
                    Click="btnCancel_Click"/>
        </StackPanel>
        
        <TextBlock x:Name="lblError" Grid.Row="6" Text="" 
                   Foreground="Red" TextWrapping="Wrap"
                   HorizontalAlignment="Center" FontSize="12"/>
    </Grid>
</Window>
