<Window x:Class="AuthApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="400" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Вход в систему" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <StackPanel Grid.Row="1" Margin="0,10">
            <TextBlock Text="Логин:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" Height="30" FontSize="14"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Margin="0,10">
            <TextBlock Text="Пароль:" FontSize="14" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="30" FontSize="14"/>
        </StackPanel>
        
        <Button x:Name="btnLogin" Grid.Row="3" Content="Войти" 
                Height="35" FontSize="14" Margin="0,20" 
                Background="LightBlue" Click="btnLogin_Click"/>
        
        <TextBlock x:Name="lblError" Grid.Row="4" Text="" 
                   Foreground="Red" TextWrapping="Wrap"
                   HorizontalAlignment="Center" FontSize="12"/>
    </Grid>
</Window>
