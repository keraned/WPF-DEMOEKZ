<Window x:Class="AuthApp.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля (Первый вход)" Height="420" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Смена пароля - Первый вход" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="DarkRed"/>
        
        <TextBlock Grid.Row="1" Text="Это ваш первый вход, необходимо сменить пароль" 
                   FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="Gray"/>
        
        <StackPanel Grid.Row="2" Margin="0,10">
            <TextBlock Text="Текущий пароль:" FontSize="14" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtCurrentPassword" Height="30" FontSize="14"/>
        </StackPanel>
        
        <StackPanel Grid.Row="3" Margin="0,10">
            <TextBlock Text="Новый пароль:" FontSize="14" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtNewPassword" Height="30" FontSize="14"/>
        </StackPanel>
        
        <StackPanel Grid.Row="4" Margin="0,10">
            <TextBlock Text="Подтверждение пароля:" FontSize="14" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtConfirmPassword" Height="30" FontSize="14"/>
        </StackPanel>
        
        <Button x:Name="btnChange" Grid.Row="5" Content="Изменить пароль" 
                Height="40" FontSize="14" Margin="0,20" 
                Background="LightGreen" Click="btnChange_Click"/>
        
        <TextBlock x:Name="lblError" Grid.Row="6" Text="" 
                   Foreground="Red" TextWrapping="Wrap"
                   HorizontalAlignment="Center" FontSize="12"/>
    </Grid>
</Window>
